# Runtime profile
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Approved model artifact.
# Prefer an absolute local path in production. Do not point this variable to an
# unreviewed public model. The API intentionally remains not ready while empty.
MODEL_NAME=

# For a remote Hugging Face repository, set an immutable commit SHA.
MODEL_REVISION=

# Production recommendation: true, with an approved model mounted locally.
MODEL_LOCAL_FILES_ONLY=false

# JSON list. Order must match model logits exactly.
MODEL_EXPECTED_LABELS=["Parasitized","Uninfected"]

# Per-process resource admission.
MAX_CONCURRENT_INFERENCES=1
INFERENCE_QUEUE_TIMEOUT_SECONDS=2.0
INFERENCE_EXECUTION_TIMEOUT_SECONDS=30.0

# Upload policy.
MAX_UPLOAD_SIZE_MB=10
# Transport allowance for multipart boundary/header bytes beyond the file limit.
MAX_MULTIPART_OVERHEAD_BYTES=1048576
MAX_IMAGE_PIXELS=25000000
MAX_FILENAME_LENGTH=255
ALLOWED_CONTENT_TYPES=["image/jpeg","image/png","image/webp"]

# JSON list of explicit browser origins. Keep empty for same-origin UI/API.
CORS_ORIGINS=[]
