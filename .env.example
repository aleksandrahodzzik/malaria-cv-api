# Runtime profile
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Approved model artifact.
# Prefer an absolute local path in production. Do not point this variable to an
# unreviewed public model. The API intentionally remains not ready while empty.
MODEL_NAME=

# Stable source identifier retained even when MODEL_NAME is an absolute local path.
MODEL_SOURCE_ID=

# Exact 40-character Hugging Face commit SHA. Branches and tags are forbidden.
MODEL_REVISION=

# Production recommendation: true, with an approved model mounted locally.
MODEL_LOCAL_FILES_ONLY=false

# JSON list. Order must match model logits exactly.
MODEL_EXPECTED_LABELS=["Parasitized","Uninfected"]

# Local trust document and its independently approved digest.
MODEL_REQUIRE_MANIFEST=true
MODEL_MANIFEST_PATH=
MODEL_MANIFEST_SHA256=

# Per-process resource admission.
MAX_CONCURRENT_INFERENCES=1
INFERENCE_QUEUE_TIMEOUT_SECONDS=2.0
INFERENCE_EXECUTION_TIMEOUT_SECONDS=30.0

# Upload policy.
MAX_UPLOAD_SIZE_MB=10
# Transport allowance for multipart boundary/header bytes beyond the file limit.
MAX_MULTIPART_OVERHEAD_BYTES=1048576
MAX_SLIDE_UPLOAD_SIZE_MB=50
MAX_IMAGE_PIXELS=25000000
MAX_FILENAME_LENGTH=255
ALLOWED_CONTENT_TYPES=["image/jpeg","image/png","image/webp"]

# JSON list of explicit browser origins. Keep empty for same-origin UI/API.
CORS_ORIGINS=[]

# Authentication and per-process abuse protection.
# Production refuses to start unless API_KEY_REQUIRED and RATE_LIMIT_ENABLED
# are both true and at least one unique, 32+ character API key is configured.
API_KEY_REQUIRED=false
API_KEYS=[]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_KEYS=10000

# Engineering QC defaults. These are not clinically validated thresholds.
QC_ENABLED=true
QC_MIN_WIDTH=32
QC_MIN_HEIGHT=32
QC_MAX_WIDTH=2048
QC_MAX_HEIGHT=2048
QC_MAX_ASPECT_RATIO=2.0
QC_MIN_CONTRAST_STD=8.0
QC_MIN_LAPLACIAN_VARIANCE=12.0
QC_MIN_STAIN_PIXEL_RATIO=0.03

# Slide-summary boundaries.
SLIDE_MIN_CELLS=10
SLIDE_MAX_CELLS=100
MAX_SLIDE_ID_LENGTH=128
